# BakeCart Environment Configuration

# Django Core
DJANGO_SECRET_KEY=django-insecure-development-key-change-in-production-!#@
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL by default, fallback to SQLite if DB_ENGINE=sqlite)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bakecart_db
DB_USER=tony
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Stripe Payment Configuration
# Obtain test keys from https://dashboard.stripe.com/test/apikeys
# Obtain the webhook secret by running: stripe listen --forward-to localhost:8000/api/payments/webhook/
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# ISO 4217 lower-case currency code (e.g. usd, eur, gbp, inr)
STRIPE_CURRENCY=usd
